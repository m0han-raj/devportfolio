---
import { siteConfig } from "../config";

const links = [
  { href: "#about", label: "About", show: true },
  {
    href: "#projects",
    label: "Projects",
    show: siteConfig.projects?.length > 0,
  },
  {
    href: "#experience",
    label: "Experience",
    show: siteConfig.experience?.length > 0,
  },
  {
    href: "#education",
    label: "Education",
    show: siteConfig.education?.length > 0,
  },
].filter((link) => link.show);
---

<header
  id="header"
  class="fixed top-0 right-0 left-0 z-50 hidden transition-all duration-300 md:block"
>
  <nav class="mx-auto max-w-7xl px-8 py-4">
    <ul class="flex items-center justify-center gap-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="nav-link text-sm font-medium text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* Applied by the scroll spy in index.astro. */
  .nav-link.nav-active {
    color: var(--c-accent);
  }
</style>

<script>
  const header = document.getElementById("header");

  const onScroll = () => {
    const scrolled = window.scrollY > 100;
    header?.classList.toggle("bg-canvas/80", scrolled);
    header?.classList.toggle("backdrop-blur-md", scrolled);
    header?.classList.toggle("border-b", scrolled);
    header?.classList.toggle("border-line", scrolled);
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
