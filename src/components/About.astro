---
import Section from "./Section.astro";
import { siteConfig } from "../config";

const hasSkills = siteConfig.skillGroups && siteConfig.skillGroups.length > 0;
---

<Section id="about" title="About Me">
  <div class="space-y-12">
    <p
      class="text-lg leading-relaxed text-pretty text-muted sm:text-xl md:text-2xl"
      data-reveal
    >
      {siteConfig.aboutMe}
    </p>

    {
      hasSkills && (
        <div class="space-y-8">
          {siteConfig.skillGroups.map((group) => (
            <div data-reveal>
              <h3 class="text-xs font-semibold tracking-[0.16em] text-muted uppercase">
                {group.category}
              </h3>
              <div class="mt-1 mb-4 h-px w-full bg-line" />
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-ink transition-colors duration-200 hover:border-accent hover:text-accent sm:text-base">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</Section>
