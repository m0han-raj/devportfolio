---
import Section from "./Section.astro";
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <Section id="projects" title="Projects">
      <div class="space-y-6">
        {siteConfig.projects.map((project, index) => {
          // An entry without a link is still worth showing — it just
          // renders as a plain card with no affordance to click.
          const Wrapper = project.link ? "a" : "div";
          const linkProps = project.link
            ? {
                href: project.link,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};

          return (
            <div class="group relative" data-reveal>
              <Wrapper
                {...linkProps}
                class={`block rounded-2xl border border-line bg-surface p-5 shadow-card transition-all duration-300 sm:p-7 md:p-8 ${
                  project.link
                    ? "hover:-translate-y-1 hover:border-accent hover:shadow-lift"
                    : ""
                }`}
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <span class="text-sm text-accent tabular-nums">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-1 text-xl font-bold text-ink sm:text-2xl">
                      {project.name}
                    </h3>
                  </div>

                  {project.link && (
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-line text-muted transition-colors duration-300 group-hover:border-accent group-hover:text-accent sm:h-11 sm:w-11">
                      <svg
                        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 sm:h-5 sm:w-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M7 17L17 7M17 7H7M17 7V17"
                        />
                      </svg>
                    </span>
                  )}
                </div>

                <p class="mt-4 text-sm leading-relaxed text-pretty text-muted sm:text-base">
                  {project.description}
                </p>

                {project.skills.length > 0 && (
                  <p class="mt-5 text-xs text-muted sm:text-sm">
                    {project.skills.filter(Boolean).join("  ·  ")}
                  </p>
                )}
              </Wrapper>
            </div>
          );
        })}
      </div>
    </Section>
  )
}
