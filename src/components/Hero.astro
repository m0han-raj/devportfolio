---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import { socials } from "../socials";
---

<div
  id="hero"
  class="relative isolate flex min-h-[88svh] flex-col justify-between overflow-hidden bg-canvas px-6 pt-28 pb-10 sm:px-10 md:min-h-screen md:px-16 md:pb-16 lg:px-24"
>
  <!-- Accent bloom, top-left. color-mix keeps it tied to whichever
       accent the active theme resolved. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 900px 700px at 0% -5%, color-mix(in oklab, var(--c-accent) 20%, transparent) 0%, color-mix(in oklab, var(--c-accent) 8%, transparent) 35%, transparent 70%);"
  >
  </div>

  <!-- Grid. Fades out toward the bottom-right so it never competes
       with the type. -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 size-full stroke-line [mask-image:radial-gradient(120%_120%_at_0%_0%,white,transparent_65%)]"
  >
    <defs>
      <pattern
        id="hero-grid"
        x="50%"
        y="-1"
        width="80"
        height="80"
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 80V.5H80" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" stroke-width="0"
    ></rect>
  </svg>

  <div
    class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center gap-10 md:flex-row md:items-center md:justify-between md:gap-16"
  >
    {
      siteConfig.avatar && (
        <figure
          class="w-56 shrink-0 sm:w-72 md:order-last md:w-80 xl:w-[28rem]"
          data-reveal
        >
          <!-- No frame: a radial mask feathers every edge into the
               canvas, so the photo reads as part of the hero in
               either theme. -->
          <Image
            src={siteConfig.avatar}
            alt={`Portrait of ${siteConfig.name}`}
            widths={[320, 480, 720, 900]}
            sizes="(min-width: 1280px) 448px, (min-width: 768px) 320px, (min-width: 640px) 288px, 224px"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover [mask-image:radial-gradient(ellipse_closest-side_at_50%_42%,black_35%,rgb(0_0_0/0.55)_65%,transparent)]"
          />
        </figure>
      )
    }

    <div>
      <p
        class="text-sm font-medium tracking-[0.2em] text-muted uppercase"
        data-reveal
      >
        Portfolio
      </p>

      <h1
        class="mt-5 text-5xl font-bold tracking-tight text-balance text-ink sm:text-6xl md:text-7xl lg:text-8xl"
        data-reveal
      >
        {siteConfig.name}
      </h1>

      <p
        class="mt-4 text-xl font-medium text-accent sm:text-2xl md:text-3xl"
        data-reveal
      >
        {siteConfig.title}
      </p>

      <p
        class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-muted sm:text-lg"
        data-reveal
      >
        {siteConfig.description}
      </p>
    </div>
  </div>

  <div
    class="mx-auto mt-12 flex w-full max-w-6xl items-center gap-x-6 text-muted md:mt-0"
    data-reveal
  >
    {
      socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          target={social.external ? "_blank" : undefined}
          rel={social.external ? "noopener noreferrer" : undefined}
          class="transition-colors duration-300 hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            {social.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      ))
    }
  </div>
</div>
