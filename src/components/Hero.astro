---
import { siteConfig } from "../config";

const socials = [
  siteConfig.social?.email && {
    href: `mailto:${siteConfig.social.email}`,
    label: "Email",
    external: false,
    paths: [
      "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
      "M3 7l9 6l9 -6",
    ],
  },
  siteConfig.social?.linkedin && {
    href: siteConfig.social.linkedin,
    label: "LinkedIn",
    external: true,
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  siteConfig.social?.twitter && {
    href: siteConfig.social.twitter,
    label: "Twitter",
    external: true,
    paths: [
      "M4 4l11.733 16h4.267l-11.733 -16z",
      "M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772",
    ],
  },
  siteConfig.social?.github && {
    href: siteConfig.social.github,
    label: "GitHub",
    external: true,
    paths: [
      "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
    ],
  },
].filter(Boolean) as {
  href: string;
  label: string;
  external: boolean;
  paths: string[];
}[];
---

<div
  id="hero"
  class="relative isolate flex min-h-[88svh] flex-col justify-between overflow-hidden bg-canvas px-6 pt-28 pb-10 sm:px-10 md:min-h-screen md:px-16 md:pb-16 lg:px-24"
>
  <!-- Accent bloom, top-left. color-mix keeps it tied to whichever
       accent the active theme resolved. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 900px 700px at 0% -5%, color-mix(in oklab, var(--c-accent) 20%, transparent) 0%, color-mix(in oklab, var(--c-accent) 8%, transparent) 35%, transparent 70%);"
  >
  </div>

  <!-- Grid. Fades out toward the bottom-right so it never competes
       with the type. -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 size-full stroke-line [mask-image:radial-gradient(120%_120%_at_0%_0%,white,transparent_65%)]"
  >
    <defs>
      <pattern
        id="hero-grid"
        x="50%"
        y="-1"
        width="80"
        height="80"
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 80V.5H80" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" stroke-width="0"
    ></rect>
  </svg>

  <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center">
    <p
      class="text-sm font-medium tracking-[0.2em] text-muted uppercase"
      data-reveal
    >
      Portfolio
    </p>

    <h1
      class="mt-5 text-5xl font-bold tracking-tight text-balance text-ink sm:text-6xl md:text-7xl lg:text-8xl"
      data-reveal
    >
      {siteConfig.name}
    </h1>

    <p
      class="mt-4 text-xl font-medium text-accent sm:text-2xl md:text-3xl"
      data-reveal
    >
      {siteConfig.title}
    </p>

    <p
      class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-muted sm:text-lg"
      data-reveal
    >
      {siteConfig.description}
    </p>
  </div>

  <div
    class="mx-auto flex w-full max-w-6xl items-center gap-x-6 text-muted"
    data-reveal
  >
    {
      socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          target={social.external ? "_blank" : undefined}
          rel={social.external ? "noopener noreferrer" : undefined}
          class="transition-colors duration-300 hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            {social.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      ))
    }
  </div>
</div>
