---
// Shared scaffold for About / Projects / Experience / Education.
// Owns the 12-column split, the spacing rhythm and the sticky
// heading, so the four content components only describe content.
//
// Note: no `items-start` on the grid — the heading column has to
// stretch to the row height for `sticky` to have anywhere to travel.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-20 px-6 py-20 sm:px-10 sm:py-24 md:px-16 lg:px-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24" data-reveal>
          <h2
            class="text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl xl:text-6xl"
          >
            {title}
          </h2>
          <div class="mt-3 h-[5px] w-[75px] rounded-full bg-accent"></div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <slot />
      </div>
    </div>
  </div>
</section>
